# Irish Property Reality Check — environment variables
#
# NONE of these are required to run the app today. The app is 100% client-side
# (React + Vite, no backend) and works fully with `npm run dev` / `npm run build`
# using zero configuration. These keys exist purely as placeholders for the
# roadmap items listed in the README ("Contributing & Future Roadmap").
#
# To use: copy this file to `.env` and fill in real values only once you start
# building the corresponding feature. `.env` is already gitignored — never
# commit real secrets.

# --- Property URL scraping (future: live Daft/MyHome listing parsing) ---
# Optional. Firecrawl API key for scraping property portal pages server-side.
# https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# --- LLM-generated content (future: AI roasts of property descriptions) ---
# Optional. Anthropic API key, used if/when the "AI roast" roadmap item ships.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Live currency conversion (future: replace hardcoded exchange rates) ---
# Optional. FX rate provider key (e.g. Fixer.io, Open Exchange Rates).
# Currently the app uses static exchangeRateFromEur values in src/data/citiesData.ts.
FX_API_KEY=

# --- Supabase (future: saved comparisons / shared "misery cards") ---
# Optional. Only needed if a persistence/backend feature is added.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
